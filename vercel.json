{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'O site não precisa de dependências'",
  "buildCommand": "npm run build && rm -rf site && mkdir site && cp -r css js proposta inicio site/ && cp dist/spazio.html site/ && cp inicio/robots.txt site/robots.txt && cp inicio/sitemap.xml site/sitemap.xml",
  "outputDirectory": "site",
  "redirects": [
    {
      "source": "/",
      "destination": "/inicio/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/spazio.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/proposta/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "regions": [
    "gru1"
  ],
  "functions": {
    "api/nfse-ponte.js": {
      "maxDuration": 60
    }
  }
}
